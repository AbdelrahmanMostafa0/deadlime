# Deadlime environment variables
# Copy to .env.local (never committed) and add the same keys in Vercel.
# Everything below is needed for V1 unless marked "optional".

# ── App ─────────────────────────────────────────────────────────────
# Public base URL. Local: http://localhost:3000. Prod: https://deadlime.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (Neon) ─────────────────────────────────────────────────
# Neon console → your project → branch "dev" (locally) or "main/prod" (Vercel) → Connect.
# Pooled connection string (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL=
# Direct (unpooled) connection string. Used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED=

# ── Auth (Better Auth) ──────────────────────────────────────────────
# Random 32+ char string. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Same as NEXT_PUBLIC_APP_URL.
BETTER_AUTH_URL=http://localhost:3000

# ── Google OAuth ────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorized redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── GitHub OAuth ────────────────────────────────────────────────────
# GitHub → Settings → Developer settings → OAuth Apps → New.
# Callback URL: <APP_URL>/api/auth/callback/github
# (One OAuth app per environment: GitHub allows a single callback URL per app.)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── GitHub App — optional, the GitHub integration is off without it ─
# GitHub → Settings → Developer settings → GitHub Apps → New.
# Callback URL: <APP_URL>/api/github/setup (tick "Request user authorization (OAuth) during installation").
# Webhook URL: <APP_URL>/api/github/webhook
# Private key: the .pem GitHub downloads, BEGIN/END lines included. Multi-line, or one line with \n.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ── Errors (Sentry) — optional, app runs without it ─────────────────
NEXT_PUBLIC_SENTRY_DSN=
# Only needed in Vercel for source map uploads at build time.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
